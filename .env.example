# OLLAMA_HOST: The URL where Ollama is running (default: http://localhost:11434)
OLLAMA_HOST="http://localhost:11434"

# OLLAMA_MODEL: The model name to use with Ollama (e.g., llama3, mistral, etc.)
OLLAMA_MODEL="llama3"

# JWT_SECRET: Secret key for signing JWT tokens.
# Change this to a strong, random string in production.
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# MARKET_DATA_CACHE_HOURS: How long to cache market data (default: 4 hours)
MARKET_DATA_CACHE_HOURS="4"
